{
  "name": "@content-gen/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared React + Kumiki-UI frontend foundation for the content generation studio.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/vendor-kumiki-paths.test.mjs",
    "test:watch": "vitest",
    "kumiki:update": "node scripts/vendor-kumiki.mjs --update-lock",
    "kumiki:verify": "node scripts/vendor-kumiki.mjs",
    "fixtures:creative": "node scripts/serve-fixtures.mjs",
    "video:produce": "node scripts/video-production/cli.mjs",
    "video:try": "node scripts/video-production/try.mjs",
    "video:studio": "node scripts/video-production/studio-server.mjs",
    "test:video:headless": "node --test scripts/video-production/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "class-variance-authority": "0.7.1",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.22.0"
}
